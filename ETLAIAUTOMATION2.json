    {
      "parameters": {
        "jsCode": "const cleanedItems = [];\n\nfor (const item of $input.all()) {\n\n  // AI output is a JSON string\n  const raw = item.json.output || item.json.text || item.json.response || item.json.data;\n\n  let obj;\n\n  try {\n    obj = JSON.parse(raw);\n  } catch (err) {\n    obj = {\n      error: \"Invalid JSON\",\n      raw_output: raw\n    };\n  }\n\n  if (!obj.error) {\n\n    obj.Student_ID = (obj.Student_ID || \"\").trim().toUpperCase();\n\n    obj.Name = (obj.Name || \"\")\n      .trim()\n      .replace(/\\s+/g, \" \");\n\n    obj.Email = (obj.Email || \"\")\n      .trim()\n      .toLowerCase();\n\n    obj.Phone = String(obj.Phone || \"\")\n      .replace(/\\D/g, \"\");\n\n    obj.Course = (obj.Course || \"\")\n      .trim();\n\n    obj.City = (obj.City || \"\")\n      .trim();\n\n    obj.Enrolled_Date = (obj.Enrolled_Date || \"\")\n      .trim();\n\n    obj.Fee_Paid = Boolean(obj.Fee_Paid);\n  }\n\n  cleanedItems.push({\n    json: obj\n  });\n\n}\n\nreturn cleanedItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        0
      ],
      "id": "d78a4ff5-0bc1-4628-92f3-6849c44155f6",
